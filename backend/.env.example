# Локальная разработка БЕЗ Docker — этот же файл используется в Docker (./backend/.env).
# Для compose также можно создать симлинк: ln -sf backend/.env .env

PROJECT_NAME="Конструктор Тренингов"

# В Docker backend слушает этот порт; Caddy проксирует api.aicsis.ru на него.
# Для локального запуска без Docker можно поставить другой (например 8002).
HOST="0.0.0.0"
PORT=8001
LOG_LEVEL="INFO"

SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=600000

DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_NAME="timofeymac"
DB_PASS="admin"

# Для Docker (сервис db) — должны совпадать с DB_* выше
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="admin"
POSTGRES_DB="timofeymac"

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# MinIO (локальное файловое хранилище, контейнер minio в compose)
MINIO_ROOT_USER="minioadmin-change-me"
MINIO_ROOT_PASSWORD="minioadmin-change-me-too"
MINIO_BUCKET="trainings"
# Публичный URL через Caddy: по нему и backend, и браузер обращаются к файлам
MINIO_ENDPOINT_URL="https://s3.aicsis.ru"

AI_API_KEY="your-ai-api-key"
AI_BASE_URL="https://routerai.ru/api/v1"
AI_MODEL="qwen/qwen3-vl-30b-a3b-instruct"
AI_VIDEO_FPS=4
AI_VIDEO_FRAME_OFFSET_SEC="0.10"

CLIENT_ID_SALUTESPEECH=""
SALUT_SPEECH_AUTORIZATION=""

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.aicsis.ru/auth/yandex/callback
FRONTEND_PUBLIC_URL=https://aicsis.ru
